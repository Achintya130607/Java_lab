<%@ tag pageEncoding="UTF-8" %>
<%@ attribute name="title" required="true" type="java.lang.String" %>

<div style="
    background:#f4f4f4;
    padding:20px;
    margin-bottom:20px;
    border-radius:8px;
    text-align:center;
    font-family:Arial,sans-serif;
">

    <h1 style="margin:0;">
        ${title}
    </h1>

</div>